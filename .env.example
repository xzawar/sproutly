NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: used ONLY by the manual demo seed script, never by the web app.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
SEED_ALLOW_DEMO_ACCOUNTS=false
# Prisma: Supabase transaction pooler for runtime; direct/session URL for schema tools.
# Use a dedicated DB login able to SET ROLE authenticated. Never expose these publicly.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
