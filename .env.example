NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: used ONLY by the manual demo seed script, never by the web app.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
SEED_ALLOW_DEMO_ACCOUNTS=false
# Prisma. Copy both strings from Supabase > Connect. Never expose these publicly.
# Runtime: the transaction pooler (port 6543). Prisma needs pgbouncer=true there,
# otherwise requests fail with "prepared statement already exists".
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL=
# Schema tools: the session pooler (port 5432) or the direct connection.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# AI features (care profile autofill, daily brief, plant assistant). Server-only.
# Without a key the app uses its built-in rules instead, so the demo still works.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
