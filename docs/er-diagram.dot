digraph ER {graph[rankdir=LR,bgcolor="#ffffff",pad="0.4",nodesep="0.35",ranksep="0.65",label="Sproutly · Database relationships",labelloc=t,fontname=Arial,fontsize=24];node[shape=record,fontname=Arial,fontsize=12,color="#a7bc96",style="rounded,filled",fillcolor="#f5faec",margin="0.18,0.12"];edge[color="#547444",fontname=Arial,fontsize=10];
