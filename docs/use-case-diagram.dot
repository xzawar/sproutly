digraph UseCases{graph[rankdir=LR,bgcolor=white,pad="0.4",label="Sproutly · Use cases and boundaries",labelloc=t,fontname=Arial,fontsize=24];node[fontname=Arial,fontsize=12,color="#a7bc96",style=filled,fillcolor="#f5faec"];edge[color="#547444",fontname=Arial,fontsize=10];guest[shape=box,label="Guest"];owner[shape=box,label="Authenticated owner"];admin[shape=box,label="Administrator"];auth[shape=box,label="Supabase Auth"];weather[shape=box,label="Open-Meteo"];subgraph cluster_app{label="Sproutly";color="#c9d6bb";access[label="Register / sign in / recover"];garden[label="Manage / archive / restore plants"];care[label="Set N-day routines / complete / skip"];cal[label="Filter calendar / inspect history"];journal[label="Record growth / dated photos"];forecast[label="Locate / inspect forecast"];rain[label="Confirm outdoor rain skip"];inbox[label="Inbox / opt-in open-tab reminders"];profile[label="Manage name / timezone"];directory[label="Read user directory"];cats[label="Manage categories"];}
guest->access;access->auth;owner->garden;owner->care;owner->cal;owner->journal;owner->forecast;forecast->weather;owner->rain;rain->care[label="records Skipped — rain"];owner->inbox;owner->profile;admin->directory;admin->cats;admin->owner[label="own garden only",style=dashed];}
